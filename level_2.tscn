"

[sub_resource type="GDScript" id="GDScript_gbfbk"]
script/source = "extends Node2D


# Called when the node enters the scene tree for the first time.
var cherry = preload(\"res://Carrot.tscn\")
var gem = preload(\"res://Gem.tscn\")
var rng := RandomNumberGenerator.new()

@onready var timer_gem := $TimerGem
@onready var timer_carrot := $TimerCarrot

func _ready():
	rng.randomize()
	start_gem_timer()
	start_carrot_timer()
	
func start_gem_timer():
	timer_gem.wait_time = rng.randi_range(2,10)
	timer_gem.start()
func start_carrot_timer():
	timer_carrot.wait_time = rng.randi_range(2,10)
	timer_carrot.start()
func _on_timer_gem_timeout() -> void:
	var gemtemp = gem.instantiate()
	
	
	var ranintx = rng.randi_range(20,2200)
	var raninty = rng.randi_range(350,415)
	gemtemp.position = Vector2(ranintx,raninty)
	add_child(gemtemp)
	start_gem_timer()


func _on_timer_carrot_timeout() -> void:
	var cherrytemp = cherry.instantiate()
	
	
	var ranintx = rng.randi_range(20,2200)
	var raninty=rng.randi_range(350,415)
	cherrytemp.position = Vector2(ranintx,raninty)
	add_child(cherrytemp) # Replace with function body.
	start_carrot_timer()
"

[sub_resource type="GDScript" id="GDScript_wse8f"]
script/source = "extends Node2D


var ene = preload(\"res://Dog.tscn\")
var sl = preload(\"res://slug.tscn\")
var rng1 = RandomNumberGenerator.new()
var rng2 = RandomNumberGenerator.new()
@onready var player = $\"../Player\"
@onready var enemy_timer :=$Dogtimer
@onready var enemy2_timer := $Slugtimer

func _ready():
	
	rng1.randomize()
	rng2.randomize()
	start_enemy_timer()
	start_enemy2_timer()
	
func start_enemy2_timer():
	enemy2_timer.wait_time = rng2.randi_range(1,2)
	enemy2_timer.start()
	

func start_enemy_timer():
	enemy_timer.wait_time = rng1.randi_range(1,2)
	enemy_timer.start()

func _on_timer_timeout() -> void:
	var enetemp = ene.instantiate()
	var safe = false
	
	var ranint1 = rng1.randi_range(20,2200)
	if abs(ranint1 - player.position.x) < 300:  # 200 pixels in front/back
			safe = false
			ranint1 = rng2.randi_range(20, 2200)
	enetemp.position = Vector2(ranint1,415)
	add_child(enetemp)
	
	start_enemy_timer()


func _on_slugtimer_timeout() -> void:
	var sltemp = sl.instantiate()
	var ranint2 =rng2.randi_range(20,2200)
	var safe = false
	while not safe:
		safe = true
		for child in get_children():
			if child.name == \"Dog\" or child.name == \"Slug\":
				if abs(child.position.x - ranint2) < 100:  # minimum distance
					safe = false
					ranint2 = rng2.randi_range(20, 2200)
					break  # check all enemies again with the new x
		if abs(ranint2 - player.position.x) < 300:  # 200 pixels in front/back
			safe = false
			ranint2 = rng2.randi_range(20, 2200)
	sltemp.position = Vector2(ranint2,400)
	add_child(sltemp)
	sltemp.call_deferred(\"assign_dir\")

	start_enemy2_timer()  # restart slug timer
"

